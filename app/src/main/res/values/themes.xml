<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, action-bar-less shell. Window background matches the Compose `background` token so
         there is no white flash before Compose draws. The app forces dark inside Compose too.

         There is deliberately no statusBarColor/navigationBarColor here: both attributes were
         deprecated in API 35 and are no-ops for any app targeting 35 or above, which this one
         does. The bars are transparent because edge-to-edge is enforced, the content draws
         behind them (navigationBarsPadding + Scaffold insets), and the bar ICON colours are
         still set - through the non-deprecated WindowCompat insets controller in ui/Theme.kt. -->
    <style name="Theme.Finador" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
